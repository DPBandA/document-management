<?xml version='1.0' encoding='UTF-8'?>
<faces-config version="2.0"
              xmlns="http://java.sun.com/xml/ns/javaee" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">
      
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>emailTemplateDialog</from-outcome>
            <to-view-id>/doc/emailTemplateDialog.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule> 
    
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>emailTemplateDialog-m</from-outcome>
            <to-view-id>/doc/emailTemplateDialog-m.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule> 
    
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>postDialog</from-outcome>
            <to-view-id>/doc/postDialog.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>   
    
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>postDialog-m</from-outcome>
            <to-view-id>/admin/postDialog-m.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>    
 
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>documentTypeDialog</from-outcome>
            <to-view-id>/admin/documentTypeDialog.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>
 
    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>documentTypeDialog-m</from-outcome>
            <to-view-id>/admin/documentTypeDialog-m.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule> 

    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>attachmentDialog</from-outcome>
            <to-view-id>/admin/attachmentDialog.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule> 

    <navigation-rule>
        <from-view-id>*</from-view-id>
        <navigation-case>
            <from-outcome>attachmentDialog-m</from-outcome>
            <to-view-id>/admin/attachmentDialog-m.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule> 
       
    <managed-bean>
        <managed-bean-name>documentManager</managed-bean-name>
        <managed-bean-class>jm.com.dpbennett.dm.manager.DocumentManager</managed-bean-class>
        <managed-bean-scope>session</managed-bean-scope>
    </managed-bean> 
        
       
</faces-config>
